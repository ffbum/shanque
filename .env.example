SHANQUE_IMAGE=ffbum/shanque:1.1
SHANQUE_PORT=5086
SHANQUE_ADMIN_PASSWORD='CHANGE_ME_BEFORE_STARTING'

# sqlite (default), kingbase (PG mode), postgresql
SHANQUE_DB_TYPE=sqlite
# For kingbase/postgresql, use a database reachable FROM the application container.
SHANQUE_DB_HOST=
# Empty: kingbase=54321, postgresql=5432
SHANQUE_DB_PORT=
SHANQUE_DB_SCHEMA=public
SHANQUE_DB_NAME=
SHANQUE_DB_USER=
# Single quotes preserve $, # and spaces in Compose .env values.
SHANQUE_DB_PASSWORD=''
SHANQUE_DB_SSLMODE=prefer
SHANQUE_DB_CONNECT_TIMEOUT=10
# Legacy full connection string: leave empty when using the fields above.
SHANQUE_DATABASE_URL=
