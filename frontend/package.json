{
  "name": "shanque-frontend",
  "version": "6.0.3",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "^3.1.14-2",
    "antd": "^6.6.0",
    "dayjs": "^1.11.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.0",
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/max": "^4.7.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "山雀企业项目工作台，基于 Ant Design Pro v6.0.3",
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "setup": "max setup",
    "lint": "biome lint src config && tsc --noEmit",
    "format": "biome check --write src config",
    "antd:lint": "antd lint ./src",
    "tsc": "tsc --noEmit"
  },
  "license": "Apache-2.0"
}
